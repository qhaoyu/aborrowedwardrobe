# Stripe API keys — get these from https://dashboard.stripe.com/apikeys
# Use your test keys (starting with sk_test_ / pk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Your production domain, used to resolve absolute URLs for social share
# images (Open Graph / Twitter cards). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://aborrowedwardrobe.com
